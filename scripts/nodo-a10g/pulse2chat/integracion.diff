+def _telefonos_del_equipo():
+    """A que telefonos llega un aviso para el equipo: uno por admin del
+    escalafon, y `AURA_PARTE_PARA` de respaldo. Salio de `_derivar_al_equipo`
+    para que Laya avise a los MISMOS: dos listas para la misma pregunta es
+    como una de las dos se queda vieja sin que nadie lo note."""
+    a_quien = []
+    for persona in escalafon.admins():
+        for donde in escalafon.formas_de(persona):
+            if donde.isdigit():
+                a_quien.append(donde)
+                break         # un aviso por persona, no por buzón
+    if not a_quien:
+        a_quien = [j for j in vistazo.JEFES if j.isdigit()]
+    return a_quien
+
