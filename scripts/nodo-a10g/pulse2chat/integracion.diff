+# ── LAYA: QUE ES ESTE MENSAJE, ANTES DE CONTESTARLO ─────────────────────────
+#
+# AU-RA esta abierta a todo el mundo, y ahi escribe cualquiera: spam, insultos,
+# estafadores que se hacen pasar por soporte, gente intentando que revele su
+# prompt, y a veces alguien en crisis. Hasta hoy todo eso llegaba al modelo
+# igual que «¿cuánto vale ORIGEN?», y el modelo improvisaba.
+#
+# Laya (en la T4) dice en milisegundos que es cada mensaje, y politica.py
+# decide que hacer: un mensaje de cuidado escrito por nosotros ante una crisis,
+# una negativa firme ante una estafa, una linea de tono en el prompt ante
+# alguien molesto, un aviso al equipo cuando hace falta una persona. Lo que no
+# hace nunca es bloquear a nadie ni borrar nada: eso lo decide una persona.
+#
+# Y si Laya esta caida, lenta o sin configurar, la decision vuelve vacia y
+# todo sigue exactamente como antes. Ver laya_cliente.py.
+
+_WA_AVISOS = []                     # la boca de WhatsApp para avisar desde otro canal
+_CANDADO_WA_AVISOS = threading.Lock()
+
+
+def _canal_de(rel):
+    if isinstance(rel, wa.RelevoWhatsApp):
+        return 'whatsapp'
+    if type(rel).__name__ == 'Recado':      # portal.py: la burbuja de la web
+        return 'web'
+    return 'chat'
+
+
+def _contacto(canal, de):
+    """Lo que ve el equipo para poder escribirle. Solo viaja en el aviso."""
+    if canal == 'whatsapp':
+        return f'+{de}'
+    if canal == 'web':
+        return 'visitante de la web (sin forma de contacto)'
+    return str(de)
+
+
+def _avisar_al_equipo_laya(rel, texto):
+    """El aviso de Laya, a los telefonos del equipo, por WhatsApp.
+
+    Por WhatsApp SIEMPRE, venga el mensaje de donde venga. Con `rel` a secas
+    no sirve: el relevo de la casa no sabe escribirle a un telefono, y el
+    `Recado` de la web ignora el destinatario y PEGA el texto en la respuesta
+    al visitante — el aviso al equipo le llegaria a la persona equivocada.
+
+    En su propio hilo: el WhatsApp va con freno (ZERNIO_HUECO) y reintentos, y
+    la persona que escribio no puede esperar a que salga un aviso interno.
+    """
+    def mandar():
+        boca = rel if isinstance(rel, wa.RelevoWhatsApp) else None
+        if boca is None and wa.encendido():
+            with _CANDADO_WA_AVISOS:
+                if not _WA_AVISOS:
+                    _WA_AVISOS.append(wa.RelevoWhatsApp(registrar=log))
+                boca = _WA_AVISOS[0]
+        a_quien = _telefonos_del_equipo()
+        if boca is None or not a_quien:
+            log('NADIE recibe el aviso de Laya: revisá AURA_ESCALAFON y WhatsApp')
+            return
+        for jefe in a_quien:
+            try:
+                boca.enviar(jefe, texto)
+            except Exception as e:
+                log('el aviso de Laya al equipo no salio:',
+                    type(e).__name__, str(e)[:70])
+    threading.Thread(target=mandar, daemon=True).start()
+
+
+def _laya_mira(rel, p, de, dicho, idi):
+    """Pregunta a Laya por UN mensaje y hace lo que la politica decida antes
+    del modelo. Devuelve la decision, o None si Laya no esta instalada.
+
+    Si la politica trae respuesta propia (crisis, estafa, abuso, spam) se
+    manda aqui y queda en la memoria de la charla, como lo del guion. Si
+    enviar falla, lanza igual que cualquier otro envio: `atender_charla` no
+    avanza el tope y el mensaje se vuelve a atender.
+    """
+    if politica is None:
+        return None
+    canal = _canal_de(rel)
+    d = politica.mirar(dicho, de, canal, idi, contacto=_contacto(canal, de))
+    if d.aviso_equipo:
+        _avisar_al_equipo_laya(rel, d.aviso_equipo)
+    if d.respuesta:
+        rel.enviar(de, d.respuesta)
+        _recordar(p, dicho, d.respuesta)
+    if d.contesta:
+        p['visto'] = int(time.time())
+        log(f'Laya ({d.accion()}) atendió a …{str(de)[-4:]} sin el modelo')
+    return d
+
