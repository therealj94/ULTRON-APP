[Unit]
Description=El motor sin GPU: habla como Ollama y contesta con Bedrock (GLM-5, relevo Kimi K2.5)
After=network-online.target
[Service]
ExecStart=/opt/ultron/venv/bin/python /opt/ultron/ollama-bedrock.py
Environment=MOTOR_REGION=us-west-2
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
