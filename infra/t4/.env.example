# Copiar a .env en la T4 (instalar.sh lo hace solo y genera el token). NUNCA subir .env al repo.

# Dirección pública con TLS. Con sslip.io no hace falta comprar dominio: la IP con guiones.
# instalar.sh la calcula sola a partir de la IP pública del nodo.
# Ejemplo: 203-0-113-9.sslip.io para la IP 203.0.113.9. Si copiás este archivo a mano, completala.
T4_DOMINIO=

# Portador que exigen Caddy y cada servicio. 48+ caracteres aleatorios; instalar.sh lo genera.
T4_TOKEN=

# Opcionales: fijar otra versión.
# LAYA_REF=970dc8c5f63d7b886a68409493f37d569424f933
# LAYA_TORCH_INDEX=cu128
# MODELO_CHICO_HF=Qwen/Qwen3-4B-GGUF:Q4_K_M
