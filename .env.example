# Sesión firmada: la ÚNICA llave de las sesiones (una cadena larga al azar, 32+ caracteres).
# Sin esto se usa una llave al azar por arranque y cada redespliegue cierra todas las sesiones.
# Ya no cae en ULTRON_MESA_CLAVE ni en ULTRON_NODO_SECRETO: con esas se fabricaban sesiones.
ULTRON_SESION_SECRETO=
# Clave de mesa opcional (header x-ultron-mesa) para clientes sin login.
ULTRON_MESA_CLAVE=

# Ejecutor de Python. En producción SOLO con sandbox: EJECUTOR_URL (servicio aparte) o EJECUTOR_DOCKER=1.
# Sin sandbox, en producción el ejecutor dice «sin sandbox» y no corre nada en el host.
EJECUTOR_ACTIVO=true
EJECUTOR_URL=
EJECUTOR_DOCKER=0

