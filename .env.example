# AU-RA FP — variables de entorno. Nombres reales; nunca fingir un nodo que no está.
# Cerebro remoto (login /entrar y /salud)
ULTRON_FP_URL=https://ultron.ordenglobal.link
ULTRON_REMOTE_URL=https://ultron.ordenglobal.link
# Nodo Qwen 3.8 27B (AWS g5). Certificado autofirmado: INSECURE_TLS solo afecta a este host.
# Las direcciones reales viven solo en Render: el repo es público (Fase 0.7). Aquí, de ejemplo.
ULTRON_NODO_URL=https://nodo-qwen.example:8443
QWEN_ENDPOINT_URL=https://nodo-qwen.example:8443
ULTRON_NODO_SECRETO=
ULTRON_NODO_MODELO=orcarouter/Qwen3.8-27B-Uncensored
ULTRON_NODO_INSECURE_TLS=1
# Ojo: Playwright + visión
ULTRON_OJO_URL=https://ojo.example:8787
PLAYWRIGHT_NODE_URL=https://ojo.example:8787
ULTRON_OJO_CLAVE=
# VOZ Y OÍDO: Voicebox en el servidor propio (Kokoro para hablar, Whisper para oír). Sin respaldo.
# Dirección de Voicebox (HTTPS, sin barra final).
VOICEBOX_URL=https://voz.example
# Llave que Voicebox pide en la cabecera X-Voz-Clave. Secreta: solo en Render, nunca en el repo.
VOICEBOX_CLAVE=
# Perfil de AU-RA en Voicebox («AU-RA · Kokoro Dora»). Vacío = el mismo, que va por omisión en el código.
VOICEBOX_PERFIL_AURA=
# Perfil de Dr Electrum («Electrum · Kokoro Alex»). Vacío = el mismo; nunca cae a la voz de AU-RA.
VOICEBOX_PERFIL_ELECTRUM=
# Laya en el nodo T4: decide el panel de especialistas de Dr Electrum. Vacío = tabla de palabras.
# Solo https (https://<ip-t4-con-guiones>.sslip.io/laya); una URL http que no sea local se ignora.
ULTRON_LAYA_URL=
ULTRON_LAYA_CLAVE=
ULTRON_LAYA_TIMEOUT_MS=800
# Visión y oído de reserva
GEMINI_API_KEY=
# Render (redespliegue de la mesa por voz, solo mando)
RENDER_API_KEY=
# El id del servicio (srv-…) está en la URL del panel de Render.
RENDER_SERVICE_ID=
AWS_DEFAULT_REGION=us-east-1
# En Render: NODE_ENV=production. Sin NODE_ENV el servidor YA se porta como producción (falla cerrado).
# Solo en tu máquina: AURA_DEV=1 abre el modo desarrollo (Vite en vivo, mesa sin clave, python local).
# `npm run dev` ya lo pone. NUNCA en Render; y si quedara puesto, NODE_ENV=production gana.
AURA_DEV=

# Sesión firmada: la ÚNICA llave de las sesiones (una cadena larga al azar, 32+ caracteres).
# Sin esto se usa una llave al azar por arranque y cada redespliegue cierra todas las sesiones.
# Ya no cae en ULTRON_MESA_CLAVE ni en ULTRON_NODO_SECRETO: con esas se fabricaban sesiones.
ULTRON_SESION_SECRETO=
# Clave de mesa opcional (header x-ultron-mesa) para clientes sin login.
ULTRON_MESA_CLAVE=

# Ejecutor de Python. En producción SOLO con sandbox: EJECUTOR_URL (servicio aparte) o EJECUTOR_DOCKER=1.
# Sin sandbox, en producción el ejecutor dice «sin sandbox» y no corre nada en el host.
EJECUTOR_ACTIVO=true
EJECUTOR_URL=
# Secreto compartido con ese sandbox (cabecera x-ejecutor-secreto). El servicio debe exigirlo: sin él,
# quien encuentre EJECUTOR_URL corre Python allí. Largo y al azar; solo en Render y en el host del sandbox.
EJECUTOR_SECRETO=
EJECUTOR_DOCKER=0

# Taller (canales). Vacío = AU-RA dice que falta, no finge el envío.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
JEFE_WHATSAPP=
JEFE_TELEFONO=
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_JEFE=
PUBLIC_BASE=

# Memoria durable (S3). Sin esto se pierde al redesplegar Render.
ULTRON_MEMORIA_BUCKET=
# Telegram de cada persona del padrón (compatibilidad): TELEGRAM_<ID>_USER_ID / _CHAT_ID / _USER_IDS, con el
# <ID> en mayúsculas tal como está en ULTRON_PADRON_BASE. Mejor: la columna «telegram» del padrón.

# ---------------------------------------------------------------- EL PADRÓN
# Quién entra a cada plataforma. AU-RA FP y Dr Electrum FP son puertas distintas: estar en una no
# es estar en la otra. Se niega por omisión — quien no está aquí, no entra.
#
# Formato de línea (cinco columnas):   id | nombre | correos | telegram | accesos
# Niveles:  lee (pregunta y mira) · escribe (además carga al cerebro) · mando (además el sistema)
# Una columna vacía FUNDE con lo que ya había; no borra.
#
#   ULTRON_PADRON="jose | | | 111222333 |
#   perez | Ing. Pérez | perez@mina.hn | 778899 | electrum=escribe
#   cliente | Minera Andina | | 991122 | electrum=lee"
#
# También acepta un array JSON si empieza por [.
ULTRON_PADRON=

# ---------------------------------------------------------------- LO PERSONAL (fuera del repo)
# El repositorio es PÚBLICO: nombres, correos, roles y gustos de la junta viven SOLO aquí, en Render
# (lib/datos-privados.ts). Sin ellas el servidor arranca igual, cerrado y sin nombres, y avisa en el registro.
#   ULTRON_PADRON_BASE   el padrón de arranque, JSON: [{"id","nombre","correos":[],"telegram":[],"apodos":[],"acceso":{"ultron":"mando"}}]
#   AURA_JUNTA           {"correo@casa": {"nombre": "…", "rol": "…"}}   (nombre y rol visibles; la huella de la junta)
#   AURA_CORREOS_ALIAS   {"correo-viejo-o-personal": "correo@casa"}
#   AURA_HECHOS_SEMILLA  ["hecho", …]   (con lo que nace la memoria de la junta)
#   AURA_PERSONAS_CLAVE  nombres, separados por comas, que vuelven «de largo plazo» un hecho
#   AURA_NOMBRES_JUNTA / AURA_NOMBRES_JUNTA_PUBLICO   nombres que el cerebro reconoce como de la junta
#   AURA_NOMBRES_TEMA_OG  nombres por los que preguntar es «tema de Orden Global» (se contesta con el cerebro)
#   AURA_CONOCIMIENTO_PERSONAS          {"personas","legal","reglas"}   (líneas del cerebro de la junta)
#   AURA_CONOCIMIENTO_PERSONAS_PUBLICO  {"personas","lanzamiento","reglas"}   (lo mismo, para la comunidad)
#   AURA_ORACION_BENDICE {"es": "…", "en": "…"}   ·   AURA_CANCION_DE {"nombre": "id-del-repertorio"}
ULTRON_PADRON_BASE=
AURA_JUNTA=
AURA_CORREOS_ALIAS=
AURA_HECHOS_SEMILLA=
AURA_PERSONAS_CLAVE=
AURA_NOMBRES_JUNTA=
AURA_NOMBRES_JUNTA_PUBLICO=
AURA_NOMBRES_TEMA_OG=
AURA_CONOCIMIENTO_PERSONAS=
AURA_CONOCIMIENTO_PERSONAS_PUBLICO=
AURA_ORACION_BENDICE=
AURA_CANCION_DE=
# Quién aprueba las cuentas pedidas desde la web (uno o varios, por comas). Sin valor por omisión.
CUENTAS_APROBADOR=
# Los agentes de la conversación de voz de ElevenLabs (scripts/elevenlabs-agentes.ts los crea e imprime).
ELEVENLABS_AGENTE_OJOS_ES=
ELEVENLABS_AGENTE_OJOS_EN=
ELEVENLABS_AGENTE_AURA_ES=
ELEVENLABS_AGENTE_AURA_EN=
ELEVENLABS_AGENTE_CLAUDIO_ES=
ELEVENLABS_AGENTE_CLAUDIO_EN=
ELEVENLABS_AGENTE_ANTONIO_ES=
ELEVENLABS_AGENTE_ANTONIO_EN=

# ---------------------------------------------------------------- FRENO DE GASTO DIARIO
# Tope global por día (de Honduras) y por proveedor (lib/freno-gasto.ts). Vacío: el de omisión (entre
# paréntesis). 0 apaga ese proveedor. Al pasarse, una línea «[freno-gasto] TOPE DIARIO ALCANZADO» en el registro.
AURA_TOPE_DIA_TTS_CARACTERES=
AURA_TOPE_DIA_STT_SEGUNDOS=
AURA_TOPE_DIA_VISION_LLAMADAS=
# (600000 caracteres de ElevenLabs TTS · 36000 segundos de oído · 5000 llamadas a los ojos)

# Llave de demostración de Dr Electrum: abre la plataforma sin crearle sesión a nadie, para
# enseñársela a un cliente. NO abre AU-RA; esa tiene la suya (ULTRON_MESA_CLAVE).
ELECTRUM_CLAVE=

# ------------------------------------------------- BOT DE TELEGRAM «DR ELECTRUM FP»
# Segundo bot, cuenta aparte. Otro token y otro secreto a propósito: un update firmado para AU-RA
# no entra por esta puerta. El webhook se registra solo al arrancar si las dos están puestas.
ELECTRUM_BOT_TOKEN=
ELECTRUM_WEBHOOK_SECRET=
# Chats de grupo donde Dr Electrum atiende a quien esté dentro, siempre con nivel de consulta.
# Vacío = solo le hablan personas del padrón. No hay sala abierta por defecto.
ELECTRUM_TELEGRAM_CHATS=


# ------------------------------------------------- BÚSQUEDA EN INTERNET
# Sin nada, busca igual: Tavily sin clave (con límite), DuckDuckGo, Bing, Wikipedia y noticias.
# Tavily gratis: 1 000 búsquedas al mes y sin tarjeta, en tavily.com. TAVILY_SIN_LLAVE=0 apaga su modo sin clave.
TAVILY_API_KEY=
# Brave ya no tiene plan gratis (desde febrero de 2026). Opcional.
BRAVE_SEARCH_API_KEY=
