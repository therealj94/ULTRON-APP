# ---------------------------------------------------------------- EL PADRÓN
# Quién entra a cada plataforma. AU-RA FP y Dr Electrum FP son puertas distintas: estar en una no
# es estar en la otra. Se niega por omisión — quien no está aquí, no entra.
#
# Formato de línea (cinco columnas):   id | nombre | correos | telegram | accesos
# Niveles:  lee (pregunta y mira) · escribe (además carga al cerebro) · mando (además el sistema)
# Una columna vacía FUNDE con lo que ya había; no borra.
#
#   ULTRON_PADRON="jose | | | 5273354540 |
#   perez | Ing. Pérez | perez@mina.hn | 778899 | electrum=escribe
#   cliente | Minera Andina | | 991122 | electrum=lee"
#
# También acepta un array JSON si empieza por [.
ULTRON_PADRON=

# Llave de demostración de Dr Electrum: abre la plataforma sin crearle sesión a nadie, para
# enseñársela a un cliente. NO abre AU-RA; esa tiene la suya (ULTRON_MESA_CLAVE).
ELECTRUM_CLAVE=

# ------------------------------------------------- BOT DE TELEGRAM «DR ELECTRUM FP»
# Segundo bot, cuenta aparte. Otro token y otro secreto a propósito: un update firmado para AU-RA
# no entra por esta puerta. El webhook se registra solo al arrancar si las dos están puestas.
ELECTRUM_BOT_TOKEN=
ELECTRUM_WEBHOOK_SECRET=
# Chats de grupo donde Dr Electrum atiende a quien esté dentro, siempre con nivel de consulta.
# Vacío = solo le hablan personas del padrón. No hay sala abierta por defecto.
ELECTRUM_TELEGRAM_CHATS=

# ---------------------------------------------------- VOZ DE DR ELECTRUM
# Id de voz de ElevenLabs para Dr Electrum. Vacío = Bill (pqHfZKP75CvOlQylNhV4), la más veterana.
# NO cae a la voz de AU-RA a propósito: si esta variable se queda vacía por un descuido, es mejor
# que el Doctor siga sonando a él que descubrirlo cuando ya habla con la voz de la otra plataforma
# delante de un cliente.
ELECTRUM_VOZ=
