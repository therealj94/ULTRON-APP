# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GitHub Personal Access Token for repository synchronization and automated deployment
GITHUB_PAT=

# Render API Key for hosting and frontend preview management
RENDER_API_KEY=

# AWS Access Credentials for SageMaker, Playwright Node, and S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Playwright Web Inspection Node endpoint
PLAYWRIGHT_NODE_URL=

# Qwen 3.8 27B Inference API endpoint
QWEN_ENDPOINT_URL=

# ElevenLabs Neural Voice API Key
ELEVENLABS_API_KEY=
