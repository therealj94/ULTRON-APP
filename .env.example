# ULTRON FP — variables de entorno. Nombres reales; nunca fingir un nodo que no está.
# Cerebro remoto (login /entrar y /salud)
ULTRON_FP_URL=https://ultron.ordenglobal.link
ULTRON_REMOTE_URL=https://ultron.ordenglobal.link
# Nodo Qwen 3.8 27B (AWS g5). Certificado autofirmado: INSECURE_TLS solo afecta a este host.
ULTRON_NODO_URL=https://34.207.148.69:8443
QWEN_ENDPOINT_URL=https://34.207.148.69:8443
ULTRON_NODO_SECRETO=
ULTRON_NODO_MODELO=orcarouter/Qwen3.8-27B-Uncensored
ULTRON_NODO_INSECURE_TLS=1
# Ojo: Playwright + visión
ULTRON_OJO_URL=http://34.229.88.165:8787
PLAYWRIGHT_NODE_URL=http://34.229.88.165:8787
ULTRON_OJO_CLAVE=
# VOZ: una sola voz (ElevenLabs v3, Gabriela). El nodo TTS local es respaldo si ElevenLabs cae.
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ=hHjbwzYZW17oh0p05AKv
ULTRON_TTS_URL=
ULTRON_TTS_CLAVE=
# Visión y oído de reserva
GEMINI_API_KEY=
# Render (redespliegue de la mesa por voz, solo mando)
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-dalojou1egvs73fb7lfg
AWS_DEFAULT_REGION=us-east-1
NODE_ENV=development

# Sesión firmada. Sin esto un redespliegue de Render cierra todas las sesiones.
ULTRON_SESION_SECRETO=
# Clave de mesa opcional (header x-ultron-mesa) para clientes sin login.
ULTRON_MESA_CLAVE=

# Ejecutor de Python. En producción SOLO con sandbox: EJECUTOR_URL (servicio aparte) o EJECUTOR_DOCKER=1.
# Sin sandbox, en producción el ejecutor dice «sin sandbox» y no corre nada en el host.
EJECUTOR_ACTIVO=true
EJECUTOR_URL=
EJECUTOR_DOCKER=0

# Taller (canales). Vacío = ULTRON dice que falta, no finge el envío.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
JEFE_WHATSAPP=
JEFE_TELEFONO=
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_JEFE=
PUBLIC_BASE=

# Memoria durable (S3). Sin esto se pierde al redesplegar Render.
ULTRON_MEMORIA_BUCKET=
TELEGRAM_JOSE_CHAT_ID=
TELEGRAM_JOSE_USER_ID=
TELEGRAM_MEDARDO_CHAT_ID=
TELEGRAM_MEDARDO_USER_ID=
