<Window x:Class="Aura.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AURA Windows" Width="420" Height="92" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" UseLayoutRounding="True">
<Border Background="#F5101720" BorderBrush="#46607A" BorderThickness="1" CornerRadius="0,0,26,26" Padding="16,8,16,14"><StackPanel>
<Grid Height="62"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
<Button Click="Toggle" ToolTip="Abrir AURA — Ctrl+Alt+Espacio" AutomationProperties.Name="Abrir panel AURA" Background="Transparent" Padding="0" Margin="0"><Grid Width="46" Height="46"><Ellipse Fill="#213D50" Stroke="#65E6D4" StrokeThickness="1.5"/><Border Width="30" Height="23" CornerRadius="10" Background="#0B1720"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="5" Height="9" Fill="#97FFED" Margin="3"/><Ellipse Width="5" Height="9" Fill="#97FFED" Margin="3"/></StackPanel></Border></Grid></Button>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="A U R A" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="State" Text="WINDOWS · LOCAL" Foreground="#91A7BB" FontSize="11"/></StackPanel><Button Grid.Column="2" Content="Voz" Click="Voice" ToolTip="Escuchar una orden; no se ejecuta hasta confirmar"/><Button Grid.Column="3" Content="−" Click="HidePanel" ToolTip="Ocultar en bandeja"/>
</Grid>
<ScrollViewer x:Name="Panel" Visibility="Collapsed" MaxHeight="540" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="¿Qué hacemos en tu PC?" Foreground="White" FontSize="23" Margin="0,14,0,12"/><WrapPanel><Button Content="Notas" Tag="abre bloc de notas" Click="Quick"/><Button Content="Calculadora" Tag="abre calculadora" Click="Quick"/><Button Content="Archivos" Tag="abre explorador" Click="Quick"/></WrapPanel>
<TextBox x:Name="Input" Margin="0,10,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Orden para Windows"/>
<TextBlock Text="Ejemplos: abre documentos · busca: tu tema · borrador: tu texto" Foreground="#91A7BB" TextWrapping="Wrap" Margin="0,6"/>
<WrapPanel><Button Content="Preparar acción" Click="Prepare"/><Button Content="Pausar" Click="Pause"/><Button Content="Reanudar" Click="Resume"/></WrapPanel>
<Border BorderBrush="#354B61" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8"><TextBlock x:Name="Status" Text="Listo. Cada acción necesita tu confirmación. El texto permanece en este equipo." Foreground="#C9D6E2" TextWrapping="Wrap"/></Border>
<Button x:Name="Confirm" Content="Confirmar acción" Visibility="Collapsed" Click="Execute" Background="#256556"/>
<TextBox x:Name="Draft" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Borrador local"/>
<WrapPanel><Button Content="Copiar borrador" Click="Copy"/><Button Content="Guardar texto…" Click="Save"/><Button Content="Salir" Click="Quit"/></WrapPanel>
<TextBlock Text="Ctrl+Alt+Espacio: abrir · Ctrl+Alt+Esc: pausa total" Foreground="#91A7BB" Margin="0,8" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></StackPanel></Border></Window>