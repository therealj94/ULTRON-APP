<Window x:Class="Aura.Windows.Notch.NotchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:n="clr-namespace:Aura.Windows.Notch" xmlns:m="clr-namespace:Aura.Windows.Marca" Title="AURA" Width="640" Height="160" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Letra}" PreviewKeyDown="Teclas">
 <Canvas x:Name="Raiz">
  <!-- La silueta: pegada al borde de arriba (o al de abajo, reflejada; se arrastra desde la píldora), con las «orejas» cóncavas y las esquinas de abajo redondas (la geometría la dibuja Forma() cada fotograma).
       El relleno y el borde los pone AplicarVidrio(): obsidiana translúcida, u obsidiana a grafito sólida con Transparencia = 1.
       Sin resplandor: lo que antes era un brillo difuso ahora es el filo grabado (Filo, abajo). -->
  <Path x:Name="Forma" Fill="#0D0C0A" MouseEnter="EntraRaton" MouseLeave="SaleRaton" MouseLeftButtonUp="ClicForma" MouseRightButtonUp="MenuForma">
   <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000D0C0A" Offset="0"/><GradientStop Color="#000D0C0A" Offset="0.35"/><GradientStop Color="#2E2A23" Offset="1"/></LinearGradientBrush></Path.Stroke>
  </Path>
  <!-- El reflejo: un velo cálido, apenas, arriba; y un filo de luz abajo. No recibe clics. -->
  <Path x:Name="Reflejo" IsHitTestVisible="False" Opacity="0">
   <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0EECE5D6" Offset="0"/><GradientStop Color="#03ECE5D6" Offset="0.42"/><GradientStop Color="#00ECE5D6" Offset="0.7"/><GradientStop Color="#08ECE5D6" Offset="1"/></LinearGradientBrush></Path.Fill>
  </Path>

  <Grid x:Name="Contenido" ClipToBounds="False">

   <!-- REPOSO: el avatar chiquito, la cámara al centro, el estado a la derecha. Al pasar el ratón, su nombre y el micrófono. -->
   <Grid x:Name="CapaReposo" IsHitTestVisible="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
     <!-- En reposo la cara de AURA es su marca (el punzón AU), no el personaje: el avatar aparece cuando escucha,
          piensa o habla. AvatarChico queda (lo usa el código) pero no se ve. -->
     <n:AvatarView x:Name="AvatarChico" Width="30" Height="30" Visibility="Collapsed"/>
     <Path x:Name="MarcaReposo" Data="{x:Static m:Contraste.Tinta}" Stretch="Uniform" Width="19" Height="19" Margin="6,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True" AutomationProperties.Name="AURA">
      <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EDD596" Offset="0"/><GradientStop Color="#C99D48" Offset="0.4"/><GradientStop Color="#9A7230" Offset="0.75"/><GradientStop Color="#D6B262" Offset="1"/></LinearGradientBrush></Path.Fill>
     </Path>
     <TextBlock x:Name="NombreChico" Text="AU-RA" FontFamily="{StaticResource LetraRotulo}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
     <!-- Con música sonando, como la isla: la portada y unas barritas. Un toque ahí abre la tarjeta de música. -->
     <StackPanel x:Name="ZonaMusicaChica" Orientation="Horizontal" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="PortadaChicaClic" AutomationProperties.Name="Ver lo que suena">
      <Border x:Name="PortadaChica" Width="20" Height="20" CornerRadius="3" Margin="0,0,6,0" Visibility="Collapsed" Background="{StaticResource Superficie2}" VerticalAlignment="Center"/>
      <n:Barras x:Name="BarrasMusica" Width="18" Height="12" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center"/>
     </StackPanel>
     <!-- Al pasar el ratón con música: anterior, play/pausa y siguiente, sin abrir nada. -->
     <StackPanel x:Name="ControlesChicos" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
      <Button Style="{StaticResource Icono}" Content="&#xE892;" Width="26" Height="26" FontSize="11" Click="MusicaAnteriorChico" ToolTip="Canción anterior" AutomationProperties.Name="Canción anterior"/>
      <Button x:Name="BotonPlayChico" Style="{StaticResource Icono}" Content="&#xE769;" Width="26" Height="26" FontSize="12" Click="MusicaPlayChico" ToolTip="Play / pausa" AutomationProperties.Name="Reproducir o pausar"/>
      <Button Style="{StaticResource Icono}" Content="&#xE893;" Width="26" Height="26" FontSize="11" Click="MusicaSiguienteChico" ToolTip="Canción siguiente" AutomationProperties.Name="Canción siguiente"/>
     </StackPanel>
     <Button x:Name="BotonCentroChico" Style="{StaticResource Icono}" Content="&#xE8A9;" Width="28" Height="28" FontSize="13" Opacity="0" Click="AbrirCentroClic" AutomationProperties.Name="Abrir el Centro"><Button.ToolTip><TextBlock>Abrir el Centro (chats, música, cartera, ajustes) <Run Style="{StaticResource Atajo}" Text="Ctrl+Alt+C"/></TextBlock></Button.ToolTip></Button>
     <Button x:Name="BotonSilencio" Style="{StaticResource Icono}" Content="&#xEC54;" Width="28" Height="28" FontSize="13" Opacity="0" Click="SilencioClic" ToolTip="Silenciar el micrófono: AURA deja de escucharte hasta que lo vuelvas a tocar" AutomationProperties.Name="Silenciar el micrófono"/>
     <Button x:Name="MicChico" Style="{StaticResource Icono}" Content="&#xE720;" Width="28" Height="28" FontSize="13" Opacity="0" Click="Microfono" AutomationProperties.Name="Hablar con AURA"><Button.ToolTip><TextBlock>Hablarle ahora <Run Style="{StaticResource Atajo}" Text="Ctrl+Alt+Espacio"/></TextBlock></Button.ToolTip></Button>
     <!-- El estado: el punzón de la marca en miniatura (cardenillo conectada, ceniza en pausa, lacre sin conexión). -->
     <Path x:Name="PuntoEstado" Data="{StaticResource Punzon}" Stretch="Uniform" Width="7" Height="7" Fill="{StaticResource Cardenillo}" Margin="6,0,4,0" VerticalAlignment="Center" ToolTip="Conectada"/>
    </StackPanel>
   </Grid>

   <!-- ESCUCHANDO -->
   <Grid x:Name="CapaEscucha" IsHitTestVisible="False" Opacity="0" Margin="0,6,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <n:AvatarView x:Name="AvatarEscucha" Width="36" Height="36" Margin="10,0,0,0" VerticalAlignment="Center" Estado="listening"/>
    <TextBlock x:Name="TextoEscucha" Grid.Column="1" Text="Te escucho…" FontSize="13" Foreground="{StaticResource Tenue}" VerticalAlignment="Center" Margin="10,0,110,0" TextTrimming="CharacterEllipsis"/>
    <!-- Tu voz, como onda grabada en cardenillo (la pátina: «te escucho»). -->
    <n:Onda x:Name="BarrasEscucha" Grid.Column="2" Width="60" Height="22" Margin="0,0,16,0" VerticalAlignment="Center" Tinta="{StaticResource Cardenillo}"/>
   </Grid>

   <!-- PENSANDO: lo que dijiste, y el canto estriado de una moneda que gira despacio -->
   <Grid x:Name="CapaPiensa" IsHitTestVisible="False" Opacity="0" Margin="0,6,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <n:AvatarView x:Name="AvatarPiensa" Width="36" Height="36" Margin="10,0,0,0" VerticalAlignment="Center" Estado="thinking"/>
    <TextBlock x:Name="TextoPiensa" Grid.Column="1" Text="Pensando…" FontSize="13" Foreground="{StaticResource Tenue}" VerticalAlignment="Center" Margin="10,0,100,0" TextTrimming="CharacterEllipsis"/>
    <n:Canto x:Name="CantoPiensa" Grid.Column="2" Width="52" Height="14" Margin="0,0,18,0" VerticalAlignment="Center"/>
   </Grid>

   <!-- HABLANDO: el avatar con su boca, el subtítulo de lo que dice y su voz como onda grabada -->
   <Grid x:Name="CapaHabla" IsHitTestVisible="False" Opacity="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <n:AvatarView x:Name="AvatarHabla" Width="58" Height="58" Margin="12,6,0,0" VerticalAlignment="Center" Estado="speaking"/>
    <!-- Con el orbe de AU-RA (NotchWindow.Orbe.cs) la capa entera es su escenario: la frase sale formada con sus partículas y esto se esconde. -->
    <StackPanel x:Name="TextosHabla" Grid.Column="1" VerticalAlignment="Center" Margin="12,8,10,0">
     <TextBlock x:Name="NombreHabla" Text="AU-RA" FontFamily="{StaticResource LetraRotulo}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Acento}"/>
     <TextBlock x:Name="Subtitulo" Text="" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="WordEllipsis" Margin="0,2,0,0"/>
    </StackPanel>
    <n:Onda x:Name="BarrasHabla" Grid.Column="2" Width="64" Height="26" Margin="0,8,18,0" VerticalAlignment="Center"/>
   </Grid>

   <!-- MÚSICA: lo que suena en Spotify, YouTube Music o el navegador, con sus controles -->
   <Grid x:Name="CapaMusica" IsHitTestVisible="False" Opacity="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="PortadaGrande" Width="58" Height="58" CornerRadius="6" BorderBrush="{StaticResource Linea}" BorderThickness="1" Margin="14,12,0,0" VerticalAlignment="Center" Background="{StaticResource Superficie2}">
     <n:Glifo x:Name="GlifoMusica" Codigo="&#xE8D6;" Width="22" Height="22" Pincel="{DynamicResource Acento}"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,12,10,0">
     <TextBlock x:Name="TituloMusica" Text="" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="ArtistaMusica" Text="" FontSize="12.5" Foreground="{StaticResource Tenue}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
     <!-- El avance: una ranura de 1 px y el oro de 2 px encima. -->
     <Grid Margin="0,9,0,0" Height="2">
      <Rectangle Height="1" Fill="{StaticResource Linea}" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
      <Border x:Name="ProgresoMusica" Height="2" Background="{DynamicResource Acento}" HorizontalAlignment="Left" Width="0" SnapsToDevicePixels="True"/>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,12,12,0" VerticalAlignment="Center">
     <Button Style="{StaticResource Icono}" Content="&#xE892;" Click="MusicaAnterior" ToolTip="Anterior" AutomationProperties.Name="Canción anterior"/>
     <Button x:Name="BotonPlayMusica" Style="{StaticResource Icono}" Content="&#xE769;" Width="40" Height="40" FontSize="18" Click="MusicaPlay" ToolTip="Play / pausa" AutomationProperties.Name="Reproducir o pausar"/>
     <Button Style="{StaticResource Icono}" Content="&#xE893;" Click="MusicaSiguiente" ToolTip="Siguiente" AutomationProperties.Name="Canción siguiente"/>
    </StackPanel>
   </Grid>

   <!-- AVISO: notificaciones al estilo de la isla (recordatorios, lo que hizo, respuestas) -->
   <Grid x:Name="CapaAviso" IsHitTestVisible="False" Opacity="0" Cursor="Hand">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <!-- El sello del aviso: llega con el golpe (1.04 → 1). El ícono, en una placa de obsidiana con filo del acento. -->
    <Grid x:Name="SelloAviso" Width="52" Height="52" Margin="14,10,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><ScaleTransform x:Name="GolpeAviso"/></Grid.RenderTransform>
     <n:AvatarView x:Name="AvatarAviso" Estado="happy"/>
     <Border x:Name="IconoAvisoFondo" Width="20" Height="20" CornerRadius="4" Background="{StaticResource Obsidiana}" BorderBrush="{DynamicResource Acento}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" SnapsToDevicePixels="True">
      <n:Glifo x:Name="IconoAviso" Codigo="&#xE73E;" Width="11" Height="11" Pincel="{DynamicResource AcentoVivo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,10,10,0">
     <TextBlock x:Name="TituloAviso" Text="" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="CuerpoAviso" Text="" FontSize="12.5" Foreground="{StaticResource Tenue}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="WordEllipsis" Margin="0,2,0,0"/>
    </StackPanel>
    <Button x:Name="BotonAviso" Grid.Column="2" Style="{StaticResource Pildora}" Margin="0,10,16,0" Padding="12,6" FontSize="12" Visibility="Collapsed" Click="AccionAviso"/>
   </Grid>

   <!-- CONFIRMAR: lo que tiene efecto (escribir en otra ventana, bloquear) espera tu «sí», por voz o aquí -->
   <Grid x:Name="CapaConfirma" IsHitTestVisible="False" Opacity="0">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <n:AvatarView x:Name="AvatarConfirma" Width="46" Height="46" Margin="14,12,0,0" VerticalAlignment="Center" Estado="listening"/>
    <StackPanel Grid.Column="1" Margin="12,14,16,0" VerticalAlignment="Center">
     <TextBlock x:Name="TituloConfirma" Text="¿Lo hago?" FontSize="14" FontWeight="SemiBold"/>
     <TextBlock x:Name="CuerpoConfirma" Text="" FontSize="12.5" Foreground="{StaticResource Tenue}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="WordEllipsis" Margin="0,2,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="16,8,16,12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <!-- La cuenta atrás: ranura de 1 px, oro de 2 px. -->
     <Grid Height="2" VerticalAlignment="Center" Margin="0,0,12,0"><Rectangle Height="1" Fill="{StaticResource Linea}" VerticalAlignment="Center" SnapsToDevicePixels="True"/><Border x:Name="CuentaAtras" Height="2" Background="{DynamicResource Acento}" HorizontalAlignment="Left" Width="0" SnapsToDevicePixels="True"/></Grid>
     <Button Grid.Column="1" Content="No" Style="{StaticResource Pildora}" Margin="0,0,8,0" Click="NoConfirma" AutomationProperties.Name="No, cancelar"/>
     <Button Grid.Column="2" Content="Sí, hazlo" Style="{StaticResource PildoraAcento}" Margin="0" Click="SiConfirma" AutomationProperties.Name="Sí, confirmar"/>
    </Grid>
   </Grid>

   <!-- EL PANEL: el chat completo, las acciones y el borrador -->
   <Grid x:Name="CapaPanel" IsHitTestVisible="False" Opacity="0">
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="18,10,14,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <n:AvatarView x:Name="AvatarPanel" Width="64" Height="64" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
      <TextBlock x:Name="NombrePanel" Text="AU-RA" FontFamily="{StaticResource LetraRotulo}" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="EstadoPanel" Text="Aquí contigo" FontSize="12" Foreground="{StaticResource Tenue}" TextTrimming="CharacterEllipsis" MaxWidth="170" HorizontalAlignment="Left"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource Icono}" Content="&#xE77B;" Click="CambiarAvatar" ToolTip="Cambiar de avatar" AutomationProperties.Name="Cambiar de avatar"/>
      <Button x:Name="BotonPausa" Style="{StaticResource Icono}" Content="&#xE769;" Click="PausaBoton" AutomationProperties.Name="Pausar todo"><Button.ToolTip><TextBlock>Pausar todo <Run Style="{StaticResource Atajo}" Text="Ctrl+Alt+Esc"/></TextBlock></Button.ToolTip></Button>
      <Button Style="{StaticResource Icono}" Content="&#xE713;" Click="AbrirAjustes" ToolTip="Ajustes" AutomationProperties.Name="Ajustes"/>
      <Button Style="{StaticResource Icono}" Content="&#xE70E;" Click="Recoger" ToolTip="Recoger al notch" AutomationProperties.Name="Recoger"/>
     </StackPanel>
    </Grid>
    <!-- Las pestañas sobre un filo de 1 px: la elegida marca el suyo en oro encima. -->
    <Grid Grid.Row="1" Margin="18,4,18,10">
     <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Linea}" SnapsToDevicePixels="True"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <RadioButton x:Name="PestanaChat" Style="{StaticResource Pestana}" Content="Conversación" IsChecked="True" GroupName="p" Checked="CambioPestana"/>
      <RadioButton x:Name="PestanaAcciones" Style="{StaticResource Pestana}" Content="Acciones" GroupName="p" Checked="CambioPestana"/>
      <RadioButton x:Name="PestanaBorrador" Style="{StaticResource Pestana}" Content="Borrador" GroupName="p" Checked="CambioPestana"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="14,0,14,0">
     <!-- Conversación -->
     <Grid x:Name="VistaChat">
      <ScrollViewer x:Name="Desplazar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="Mensajes" Margin="4,0,4,8">
        <StackPanel x:Name="Bienvenida" Margin="6,12,6,8">
         <!-- La firma de la casa: el punzón en una tinta y «AU·RA FP» estampado. -->
         <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Path Data="{StaticResource MarcaTinta}" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource Acento}" VerticalAlignment="Center"/>
          <m:Rotulo Texto="AU·RA" Tamano="12.5" Tracking="0.12" Tinta="{StaticResource Texto}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <m:Rotulo Texto="FP" Mono="True" Tamano="11" Tracking="0.12" Tinta="{DynamicResource Acento}" Margin="5,1,0,0" VerticalAlignment="Center"/>
         </StackPanel>
         <TextBlock x:Name="SaludoGrande" Text="¿En qué te ayudo?" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="Háblame o escríbeme. Puedo abrir apps, buscar, mirar tu pantalla, redactar documentos, escribir en Word o el Bloc de notas y recordarte cosas." Foreground="{StaticResource Tenue}" TextWrapping="Wrap" Margin="0,8,0,14"/>
         <WrapPanel>
          <Button Style="{StaticResource Pildora}" Content="¿Qué ves en mi pantalla?" Tag="qué ves en mi pantalla" Click="Sugerencia"/>
          <Button Style="{StaticResource Pildora}" Content="Redáctame un correo" Tag="Redáctame un correo corto y formal para pedir una reunión la próxima semana" Click="Sugerencia"/>
          <Button Style="{StaticResource Pildora}" Content="Recuérdame en 10 min" Tag="recuérdame en 10 minutos estirar las piernas" Click="Sugerencia"/>
          <Button Style="{StaticResource Pildora}" Content="Abre la calculadora" Tag="abre la calculadora" Click="Sugerencia"/>
         </WrapPanel>
         <Border x:Name="AvisoCuenta" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,8,0,0" Visibility="Collapsed">
          <StackPanel><TextBlock Text="Entra con tu cuenta de AU-RA para que te recuerde, use tu memoria y Laya decida más rápido. Conversar ya funciona." TextWrapping="Wrap" Foreground="{StaticResource Tenue}"/>
           <Button Style="{StaticResource Pildora}" Content="Entrar →" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AbrirAjustes"/></StackPanel>
         </Border>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Grid>
     <!-- Acciones -->
     <ScrollViewer x:Name="VistaAcciones" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="4,4,4,8">
       <TextBlock Text="Tu computadora, a la mano" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,10"/>
       <WrapPanel>
        <Button Style="{StaticResource Pildora}" Content="Bloc de notas" Tag="abre el bloc de notas" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Calculadora" Tag="abre la calculadora" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Documentos" Tag="abre documentos" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Descargas" Tag="abre descargas" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Captura de pantalla" Tag="toma una captura de pantalla" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Mira mi pantalla" Tag="qué ves en mi pantalla" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Mostrar escritorio" Tag="minimiza todo" Click="Sugerencia"/>
        <Button Style="{StaticResource Pildora}" Content="Llamadas y video" Click="AbrirLlamadas"/>
       </WrapPanel>
       <TextBlock Text="Aplicaciones de este equipo" FontWeight="SemiBold" Margin="2,14,0,8"/>
       <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="6" Padding="12,7"><TextBox x:Name="BuscarApp" TextChanged="FiltrarApps" AutomationProperties.Name="Buscar una aplicación"/></Border>
       <ListBox x:Name="ListaApps" Height="150" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Texto}" Margin="0,6,0,6" DisplayMemberPath="Nombre" MouseDoubleClick="AbrirAppLista"/>
       <TextBlock Text="Recordatorios" FontWeight="SemiBold" Margin="2,10,0,8"/>
       <StackPanel x:Name="ListaRecordatorios"/>
       <TextBlock x:Name="SinRecordatorios" Text="Nada pendiente. Dime «recuérdame en 20 minutos…»." Foreground="{StaticResource Tenue}" Margin="2,0,0,0"/>
      </StackPanel>
     </ScrollViewer>
     <!-- Borrador -->
     <Grid x:Name="VistaBorrador" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="6" Padding="14,10">
       <TextBox x:Name="Borrador" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="100000" TextChanged="BorradorCambio" AutomationProperties.Name="Borrador"/>
      </Border>
      <StackPanel Grid.Row="1" Margin="0,10,0,0">
       <WrapPanel>
        <Button Style="{StaticResource Pildora}" Content="Copiar" Click="CopiarBorrador"/>
        <Button Style="{StaticResource Pildora}" Content="Guardar…" Click="GuardarBorrador"/>
        <Button Style="{StaticResource PildoraAcento}" Content="Escribir en la ventana elegida" Click="EscribirBorrador"/>
       </WrapPanel>
       <TextBlock x:Name="DestinoTexto" Text="Haz clic en Word o el Bloc de notas y pulsa Ctrl+Alt+W, o dime «escríbelo en Word»." Foreground="{StaticResource Tenue}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Grid>

    <!-- Barra de escribir/hablar -->
    <Grid Grid.Row="3" Margin="14,10,14,16">
     <!-- Con el foco dentro, su filo pasa a oro. -->
     <Border Background="{StaticResource Superficie}" BorderThickness="1" CornerRadius="8" Padding="5" SnapsToDevicePixels="True">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
       <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger></Style.Triggers></Style></Border.Style>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Width="40" Height="40">
        <!-- Abierto el micrófono: un filo cardenillo alrededor que se abre con tu voz. -->
        <Rectangle x:Name="AnilloMic" RadiusX="6" RadiusY="6" Stroke="{StaticResource Cardenillo}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EscalaAnillo"/></Rectangle.RenderTransform></Rectangle>
        <Button x:Name="MicGrande" Style="{StaticResource Icono}" Content="&#xE720;" Width="40" Height="40" FontSize="16" Click="Microfono" AutomationProperties.Name="Hablar"><Button.ToolTip><TextBlock>Hablar <Run Style="{StaticResource Atajo}" Text="Ctrl+Alt+Espacio"/></TextBlock></Button.ToolTip></Button>
       </Grid>
       <TextBox x:Name="Entrada" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" MaxLength="8000" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" KeyDown="EntradaTecla" AutomationProperties.Name="Mensaje para AURA"/>
       <TextBlock x:Name="Pista" Grid.Column="1" Text="Escríbeme o toca el micrófono…" Foreground="{StaticResource Pista}" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
       <Button x:Name="Enviar" Grid.Column="2" Style="{StaticResource Icono}" Content="&#xE724;" Width="40" Height="40" Background="{DynamicResource AcentoSuave}" BorderBrush="{DynamicResource Acento}" Foreground="{DynamicResource AcentoVivo}" Click="EnviarClic" AutomationProperties.Name="Enviar"><Button.ToolTip><TextBlock>Enviar <Run Style="{StaticResource Atajo}" Text="Enter"/></TextBlock></Button.ToolTip></Button>
      </Grid>
     </Border>
    </Grid>
   </Grid>

   <!-- EL FILO GRABADO: 1 px de oro a lo largo del canto libre de la silueta. Con el ratón se graba desde el centro
        hacia afuera; al escuchar es cardenillo y respira; al llegar un aviso, un único destello. Nunca un resplandor. -->
   <Grid x:Name="Filo" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
    <Grid.RenderTransform><ScaleTransform x:Name="EscalaFilo" ScaleX="0"/></Grid.RenderTransform>
    <Rectangle x:Name="FiloLinea"/>
    <Rectangle x:Name="FiloDestello" Fill="{StaticResource OroPulido}" Opacity="0"/>
   </Grid>

   <!-- La cámara del notch, al centro, como el de la imagen: solo arriba al centro (movido, quedan ocultos sus puntos).
        La luz naranja del micrófono se ve siempre, esté donde esté. -->
   <StackPanel x:Name="Camara" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" IsHitTestVisible="False">
    <Ellipse x:Name="PuntoCamara" Width="6" Height="6" Fill="#0A0908" Stroke="#1A1713" StrokeThickness="1" Margin="0,1,14,0"/>
    <Grid x:Name="LenteCamara" Width="9" Height="9">
     <Ellipse Fill="#070605" Stroke="#1C1915" StrokeThickness="1"/>
     <Ellipse Width="4" Height="4" Margin="3,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5A4E38" Offset="0"/><GradientStop Color="#17140F" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
    </Grid>
    <!-- La luz del micrófono abierto: lacre, la cera del sello (grabando). -->
    <Ellipse x:Name="LuzMic" Width="5" Height="5" Fill="{StaticResource Lacre}" Margin="10,2,0,0" Opacity="0" ToolTip="Micrófono abierto"/>
   </StackPanel>
  </Grid>
 </Canvas>
</Window>
