# Set via the service manager; server.mjs does not implicitly load .env files.
HOST=127.0.0.1
PORT=8787
WINDOWS_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WINDOWS_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
WINDOWS_CHAT_MODEL=REPLACE_WITH_INSTALLED_MODEL_NAME
WINDOWS_MODEL_KEY=
# openai or ollama; choose ollama for the /api/chat endpoint.
WINDOWS_MODEL_PROTOCOL=openai
# authorization or x-ultron-secreto; only the server uses this key.
WINDOWS_MODEL_AUTH_HEADER=authorization
# TURN needed for reliable calls across NAT/firewalls. Use your own server.
WINDOWS_TURN_URLS=[]
WINDOWS_TURN_SECRET=
WINDOWS_ICE_SERVERS=[]
