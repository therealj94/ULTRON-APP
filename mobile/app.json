{
  "expo": {
    "name": "ULTRON FP",
    "slug": "ultron-fp",
    "version": "2.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "link.ordenglobal.ultronfp",
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive",
        "barStyle": "light-content",
        "backgroundColor": "#000000"
      }
    },
    "scheme": "ultronfp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d41656ec-6fc7-4fd2-b183-eba687473fd9",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "ultronUrl": "https://ultron-looi-desk.onrender.com",
      "eas": {
        "projectId": "d41656ec-6fc7-4fd2-b183-eba687473fd9"
      }
    },
    "owner": "vetawallet",
    "plugins": [
      "expo-system-ui",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ULTRON FP necesita el micrófono para escucharte.",
          "speechRecognitionPermission": "ULTRON FP usa reconocimiento de voz nativo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ULTRON FP usa la cámara para visión del escritorio.",
          "microphonePermission": "ULTRON FP necesita micrófono con la cámara.",
          "recordAudioAndroid": true
        }
      ],
      "expo-av"
    ]
  }
}
