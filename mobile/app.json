{
  "expo": {
    "name": "AU-RA FP",
    "slug": "ultron-fp",
    "version": "5.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "link.ordenglobal.ultronfp",
      "versionCode": 54,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "scheme": "ultronfp",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/58d1d3e5-9d36-466a-8e0c-86a17994de99",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "ultronUrl": "https://ultron-looi-desk.onrender.com",
      "eas": {
        "projectId": "58d1d3e5-9d36-466a-8e0c-86a17994de99"
      }
    },
    "owner": "ordenglobal",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-system-ui",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "AU-RA FP usa la cámara para mirarte e identificar lo que hay en la mesa.",
          "microphonePermission": "AU-RA FP te escucha de forma continua para conversar sin palabra clave.",
          "recordAudioAndroid": true
        }
      ],
      "expo-av",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AU-RA FP te escucha de forma continua para conversar sin palabra clave.",
          "speechRecognitionPermission": "AU-RA FP convierte tu voz en texto en el teléfono.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      "./plugins/servicio-llamada",
      "./plugins/recordatorio-llamada"
    ]
  }
}
